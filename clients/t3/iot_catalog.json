{
  "schema_version": 1,
  "description": "IoT device catalog for the T3 / cs simulation fleet. The single source of truth for the per-device DHCP fingerprint (option 60 vendor-class-id + option 55 parameter-request-list), the vendor OUI MAC prefix, the simulated hostname, and the per-vendor traffic endpoints each emulated device generates. Two existing T3 files are DERIVED from this catalog (see catalog.py --emit-mac-config / --emit-fingerprints): mac_config.json (the OUI pool consumed by gen_macs.sh) and the fingerprint+traffic block in wireless.sh. Keep this catalog canonical; regenerate the derived files after edits rather than hand-editing them.",
  "notes": [
    "Devices with a non-null 'oui' form the MAC pool (mac_config.json); the emitted total count must be <= 25 (gen_macs.sh hard limit).",
    "Devices with a null 'oui' still carry a DHCP fingerprint + traffic profile but get no vendor MAC (they reuse the host OUI).",
    "'verified: true' means the fingerprint + OUI came from the existing T3 wireless.sh / mac_config.json (the user's real captured data). 'verified: false' means the profile is reconstructed from known DHCP-fingerprint patterns and the OUI must be confirmed against the IEEE OUI registry before fleet use.",
    "param_request_list is the DHCP option 55 value as an int list (e.g. [1,3,6] = subnet-mask, router, DNS). vendor_class_id is the DHCP option 60 string verbatim.",
    "traffic endpoints are grouped by generator: dns (dig/nslookup), curl (raw HTTP(S) fetch), http (headless browser visit), wget (recursive site fetch). Empty arrays = the device emits no application traffic (DHCP/DNS fingerprint only)."
  ],
  "categories": {
    "industrial-controller": "PLC / building controller (Mercury, Crestron, Lutron)",
    "garage-door": "Smart garage / myQ-style opener (LiftMaster)",
    "digital-signage": "Networked media player / signage (BrightSign, PlaySignage, Barco, WePresent)",
    "printer": "Network printer / label printer (HP, Zebra)",
    "ip-phone": "VoIP desk phone (Polycom, Yealink)",
    "ip-camera": "Surveillance camera (Axis, Hikvision, Ring, Wyze)",
    "serial-server": "Industrial serial/device server (Moxa)",
    "doorbell": "Video doorbell / security (Ring)",
    "thermostat": "Smart thermostat / HVAC (Resideo, Nest, Ecobee)",
    "occupancy-sensor": "People-count / occupancy sensor (Density)",
    "vr-headset": "Standalone VR / AR (Oculus / Meta Quest)",
    "ev": "Electric vehicle / charger telemetry (Tesla)",
    "smart-speaker": "Voice assistant / smart speaker (Sonos, Echo, Google Home)",
    "smart-display": "Smart display / hub (Alexa Show, Google Nest Hub)",
    "smart-lock": "Networked door lock (August, Yale)",
    "smart-lighting": "Lighting bridge / smart bulb (Hue, Shelly, TP-Link, Tuya)",
    "smart-plug": "Wi-Fi smart plug / relay (TP-Link, Tuya, Shelly)",
    "robot-vacuum": "Robotic vacuum / mower (iRobot, Ecovacs)",
    "sensor-tag": "Low-power Wi-Fi sensor / ESP8266/ESP32 endpoint",
    "iot-gateway": "Multi-protocol IoT hub / bridge (SmartThings, Hubitat, Aqara)",
    "mobile": "Consumer mobile / tablet (Apple, Samsung, Microsoft Surface)",
    "network-infra": "Network infrastructure device (Cisco)"
